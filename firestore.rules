rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny all incoming traffic
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }

    // Student Profiles
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // Academic Subjects
    match /subjects/{subjectId} {
      allow read, write: if true;
    }

    // Student Carpools & Cab Rides (Cross-device persistence)
    match /rides/{rideId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Seat Requests (Cross-device booking requests)
    match /seat_requests/{requestId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Challenges
    match /challenges/{challengeId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // Challenge Participations
    match /challenge_participations/{participationId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // Campus Events
    match /events/{eventId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // Event Registrations
    match /event_registrations/{registrationId} {
      allow read, write: if true;
    }

    // Peer Learning Sessions
    match /learning_sessions/{sessionId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Time-Credit Ledger
    match /credit_transactions/{transactionId} {
      allow read, write: if true;
    }

    // Student Notifications
    match /notifications/{notificationId} {
      allow read, write: if true;
    }
  }
}
